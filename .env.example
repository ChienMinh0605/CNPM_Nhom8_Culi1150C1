VNPAY_RETURN_URL=http://localhost:8080/api/v1/payment/return

# --- Cloudinary (lưu ảnh) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Brevo (gửi email) ---
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Bảo tàng Dòng chảy Sử Việt
