# Chép file này thành .env rồi điền giá trị. KHÔNG commit file .env.

# --- PostgreSQL ---
POSTGRES_DB=dcsv
POSTGRES_USER=dcsv
POSTGRES_PASSWORD=doi_mat_khau_nay
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
CORS_ALLOWED_ORIGIN=*
JWT_SECRET=doi_chuoi_bi_mat_nay

# --- VNPay Sandbox (đăng ký tại https://sandbox.vnpayment.vn/devreg) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPay chuyển khách về trang kết quả của frontend.
VNPAY_RETURN_URL=http://localhost:5180/#/ket-qua-thanh-toan
# Địa chỉ IPN khai báo trên trang quản lý của VNPay, phải truy cập được từ
# Internet: https://<địa chỉ công khai>/api/v1/payment/ipn

# --- Cloudinary (lưu ảnh) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Brevo (gửi email) ---
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Bảo tàng Dòng chảy Sử Việt
