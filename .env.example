# Chép file này thành .env rồi điền giá trị. KHÔNG commit file .env.

# --- PostgreSQL ---
POSTGRES_DB=dcsv
POSTGRES_USER=dcsv
POSTGRES_PASSWORD=doi_mat_khau_nay
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
CORS_ALLOWED_ORIGIN=*
JWT_SECRET=doi_chuoi_bi_mat_nay

# --- VNPay Sandbox (đăng ký tại https://sandbox.vnpayment.vn/devreg) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
