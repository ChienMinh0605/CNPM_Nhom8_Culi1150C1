="90" width="10" height="20" as="geometry"/></mxCell><mxCell id="c114" value="② Thanh toán" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontStyle=1;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;autosize=1;fontFamily=Noto Sans;" vertex="1" parent="1"><mxGeometry x="6" y="372" width="10" height="20" as="geometry"/></mxCell><mxCell id="c115" value="③ Xác nhận kết quả" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontStyle=1;fontColor=#6B7280;labelBackgroundColor=#F4F6FB;autosize=1;fontFamily=Noto Sans;" vertex="1" parent="1"><mxGeometry x="6" y="436" width="10" height="20" as="geometry"/></mxCell><mxCell id="c116" value="④ Trả kết quả" style="text;html=1;align=left;verticalAlign=middle;fontSize=13.5;fontStyle=1;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;autosize=1;fontFamily=Noto Sans;" vertex="1" parent="1"><mxGeometry x="6" y="604" width="10" height="20" as="geometry"/></mxCell><mxCell id="c117" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#3B6FB6;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="393" y="118" width="14" height="244" as="geometry"/></mxCell><mxCell id="c118" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#3B6FB6;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="393" y="466" width="14" height="228" as="geometry"/></mxCell><mxCell id="c119" value="" style="endArrow=block;endFill=1;endSize=8;html=1;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="128" as="sourcePoint"/><mxPoint x="393" y="128" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c120" value="1. Chọn ngày, khung giờ, loại vé" style="text;html=1;align=center;verticalAlign=bottom;fontSize=17.5;fontColor=#1F2937;labelBackgroundColor=none;fontFamily=Noto Sans;" vertex="1" parent="1"><mxGeometry x="100" y="101" width="293" height="24" as="geometry"/></mxCell><mxCell id="c121" value="" style="endArrow=block;endFill=1;endSize=8;html=1;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="407" y="146" as="sourcePoint"/><mxPoint x="407" y="168" as="targetPoint"/><Array as="points"><mxPoint x="439" y="146"/><mxPoint x="439" y="168"/></Array></mxGeometry></mxCell><mxCell id="c122" value="2. Kiểm tra chỗ trống" style="text;html=1;align=left;verticalAlign=middle;fontSize=17.5;fontColor=#1F2937;whiteSpace=wrap;fontFamily=Noto Sans;" vertex="1" parent="1"><mxGeometry x="447" y="145.5" width="270" height="23" as="geometry"/></mxCell><mxCell id="c123" value="break [hết chỗ]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=150;height=24;fillColor=#FFF5F5;swimlaneFillColor=none;strokeColor=#B23A3A;strokeWidth=1.4;fontSize=15;fontStyle=1;fontColor=#B23A3A;align=left;spacingLeft=6;fontFamily=Noto Sans;" vertex="1" parent="1"><mxGeometry x="30" y="186" width="490" height="66" as="geometry"/></mxCell><mxCell id="c124" value="" style="endArrow=open;endFill=0;endSize=9;html=1;dashed=1;dashPattern=6 4;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="393" y="240" as="sourcePoint"/><mxPoint x="100" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c125" value="Báo hết chỗ, chọn khung giờ khác" style="text;html=1;align=center;verticalAlign=bottom;fontSize=17.5;fontColor=#1F2937;labelBackgroundColor=none;fontFamily=Noto Sans;" vertex="1" parent="1"><mxGeometry x="100" y="213" width="293" height="24" as="geometry"/></mxCell><mxCell id="c126" value="" style="endArrow=block;endFill=1;endSize=8;html=1;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="407" y="270" as="sourcePoint"/><mxPoint x="407" y="296" as="targetPoint"/><Array as="points"><mxPoint x="439" y="270"/><mxPoint x="439" y="296"/></Array></mxGeometry></mxCell><mxCell id="c127" value="3. Tạo đơn «Chờ thanh toán»,&lt;br&gt;giữ chỗ 15 phút" style="text;html=1;align=left;verticalAlign=middle;fontSize=17.5;fontColor=#1F2937;whiteSpace=wrap;fontFamily=Noto Sans;" vertex="1" parent="1"><mxGeometry x="447" y="260.0" width="270" height="46" as="geometry"/></mxCell><mxCell id="c128" value="" style="endArrow=open;endFill=0;endSize=9;html=1;dashed=1;dashPattern=6 4;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="393" y="350" as="sourcePoint"/><mxPoint x="100" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c129" value="4. Chuyển sang trang VNPay" style="text;html=1;align=center;verticalAlign=bottom;fontSize=17.5;fontColor=#1F2937;labelBackgroundColor=none;fontFamily=Noto Sans;" vertex="1" parent="1"><mxGeometry x="100" y="323" width="293" height="24" as="geometry"/></mxCell><mxCell id="c130" value="" style="endArrow=block;endFill=1;endSize=8;html=1;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="414" as="sourcePoint"/><mxPoint x="720" y="414" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c131" value="5. Thanh toán trên VNPay" style="text;html=1;align=center;verticalAlign=bottom;fontSize=17.5;fontColor=#1F2937;labelBackgroundColor=none;fontFamily=Noto Sans;" vertex="1" parent="1"><mxGeometry x="105" y="387" width="288" height="24" as="geometry"/></mxCell><mxCell id="c132" value="" style="endArrow=block;endFill=1;endSize=8;html=1;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="478" as="sourcePoint"/><mxPoint x="407" y="478" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c133" value="6. Gửi kết quả giao dịch (IPN)" style="text;html=1;align=center;verticalAlign=bottom;fontSize=17.5;fontColor=#1F2937;labelBackgroundColor=none;fontFamily=Noto Sans;" vertex="1" parent="1"><mxGeometry x="407" y="451" width="313" height="24" as="geometry"/></mxCell><mxCell id="c134" value="" style="endArrow=block;endFill=1;endSize=8;html=1;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="407" y="496" as="sourcePoint"/><mxPoint x="407" y="522" as="targetPoint"/><Array as="points"><mxPoint x="439" y="496"/><mxPoint x="439" y="522"/></Array></mxGeometry></mxCell><mxCell id="c135" value="7. Kiểm tra chữ ký →&lt;br&gt;«Đã thanh toán», sinh QR" style="text;html=1;align=left;verticalAlign=middle;fontSize=17.5;fontColor=#1F2937;whiteSpace=wrap;fontFamily=Noto Sans;" vertex="1" parent="1"><mxGeometry x="447" y="486.0" width="270" height="46" as="geometry"/></mxCell><mxCell id="c136" value="" style="endArrow=open;endFill=0;endSize=10;html=1;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="407" y="578" as="sourcePoint"/><mxPoint x="935" y="578" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c137" value="8. Gửi vé QR qua email" style="text;html=1;align=center;verticalAlign=bottom;fontSize=17.5;fontColor=#1F2937;labelBackgroundColor=none;fontFamily=Noto Sans;" vertex="1" parent="1"><mxGeometry x="727" y="551" width="203" height="24" as="geometry"/></mxCell><mxCell id="c138" value="" style="endArrow=block;endFill=1;endSize=8;html=1;strokeColor=#374151;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="640" as="sourcePoint"/><mxPoint x="407" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c139" value="9. Chuyển về trang kết quả" style="text;html=1;align=center;verticalAlign=bottom;fontSize=17.5;fontColor=#1F2937;labelBackgroundColor=none;fontFamily=Noto Sans;" vertex="1" parent="1"><mxGeometry x="407" y="613" width="313" height="24" as="geometry"/></mxCell><mxCell id="c140" value="" style="endArrow=open;endFill=0;endSize=9;html=1;dashed=1;dashPattern=6 4;strokeColor=#374151;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="393" y="686" as="sourcePoint"/><mxPoint x="100" y="686" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c141" value="10. Hiển thị kết quả và vé QR" style="text;html=1;align=center;verticalAlign=bottom;fontSize=17.5;fontColor=#1F2937;labelBackgroundColor=none;fontFamily=Noto Sans;" vertex="1" parent="1"><mxGeometry x="100" y="659" width="293" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Slide9-VongDoiDonVe" id="s9state"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="450" pageHeight="560" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c142" value="" style="ellipse;html=1;fillColor=#1F2937;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="8" width="22" height="22" as="geometry"/></mxCell><mxCell id="c143" value="&lt;b style=&#x27;font-size:18px&#x27;&gt;Chờ thanh toán&lt;/b&gt;&lt;br&gt;&lt;i style=&#x27;font-size:14px;color:#4B5563&#x27;&gt;entry / giữ chỗ 15 phút&lt;/i&gt;" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#FDF4E3;strokeColor=#B7791F;strokeWidth=2;fontColor=#1F2937;fontFamily=Noto Sans;" vertex="1" parent="1"><mxGeometry x="15" y="78" width="220" height="66" as="geometry"/></mxCell><mxCell id="c144" value="&lt;b style=&#x27;font-size:18px&#x27;&gt;Đã thanh toán&lt;/b&gt;&lt;br&gt;&lt;i style=&#x27;font-size:14px;color:#4B5563&#x27;&gt;entry / sinh QR, gửi email vé&lt;/i&gt;" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#EAF2FD;strokeColor=#3B6FB6;strokeWidth=2;fontColor=#1F2937;fontFamily=Noto Sans;" vertex="1" parent="1"><mxGeometry x="15" y="232" width="220" height="66" as="geometry"/></mxCell><mxCell id="c145" value="&lt;b style=&#x27;font-size:18px&#x27;&gt;Đã sử dụng&lt;/b&gt;&lt;br&gt;&lt;i style=&#x27;font-size:14px;color:#4B5563&#x27;&gt;entry / ghi giờ vào cổng&lt;/i&gt;" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#E6F4F1;strokeColor=#1F7A6B;strokeWidth=2;fontColor=#1F2937;fontFamily=Noto