okeColor=#374151;strokeWidth=1.6;fontFamily=Noto Sans;fontSize=13;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="846.0" y="476" as="sourcePoint"/><mxPoint x="1084.0" y="476" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r8" value="đơn vé (hoặc không có)" style="html=1;endArrow=open;endSize=11;dashed=1;dashPattern=7 4;strokeColor=#6B7280;strokeWidth=1.4;fontFamily=Noto Sans;fontSize=13;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1084.0" y="516" as="sourcePoint"/><mxPoint x="846.0" y="516" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r9" value="" style="html=1;endArrow=block;endFill=1;endSize=10;strokeColor=#374151;strokeWidth=1.6;fontFamily=Noto Sans;fontSize=13;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="846.0" y="554" as="sourcePoint"/><mxPoint x="846.0" y="578" as="targetPoint"/><Array as="points"><mxPoint x="882.0" y="554"/><mxPoint x="882.0" y="578"/></Array></mxGeometry></mxCell><mxCell id="r10" value='&lt;b&gt;6.&lt;/b&gt; Kiểm tra 4 điều kiện: tồn tại, đã thanh toán,&lt;br&gt;đúng ngày, chưa sử dụng&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#6B7280"&gt;validate(order, today)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;align=left;verticalAlign=middle;fontFamily=Noto Sans;fontSize=13;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="890.0" y="530.0" width="363.0" height="58.0" as="geometry"/></mxCell><mxCell id="r11" value='&lt;b&gt;7.&lt;/b&gt; Cập nhật vé «Đã sử dụng»,&lt;br&gt;ghi giờ vào&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#6B7280"&gt;order.checkIn(), save(order)&lt;/font&gt;&lt;/i&gt;' style="html=1;endArrow=block;endFill=1;endSize=10;strokeCol